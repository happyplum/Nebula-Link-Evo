{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "rootDirs": ["./src", "../../libs/shared"],
    "paths": {
      "@nebula-link-evo/shared": ["../../libs/shared/index.ts"],
      "@nebula-link-evo/shared/*": ["../../libs/shared/*"]
    }
  },
  "include": ["src/**/*", "src/__tests__/**/*", "src/**/*.test.ts", "playwright.config.ts"]
}
