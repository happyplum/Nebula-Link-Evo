{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "declaration": true,
    "composite": true
  },
  "include": ["types/**/*", "utils/**/*", "index.ts"],
  "exclude": ["node_modules", "dist", "test-utils/**/*", "**/*.test.ts", "**/__tests__/**"]
}
