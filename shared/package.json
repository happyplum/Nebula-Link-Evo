{
  "name": "@nebula-link-evo/shared",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Shared types and utilities for Nebula-Link Evo",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./types/sse-events": {
      "types": "./dist/types/sse-events.d.ts",
      "import": "./dist/types/sse-events.js"
    },
    "./types/vision-marker": {
      "types": "./dist/types/vision-marker.d.ts",
      "import": "./dist/types/vision-marker.js"
    },
    "./types/debug-events": {
      "types": "./dist/types/debug-events.d.ts",
      "import": "./dist/types/debug-events.js"
    },
    "./types/browser-execution": {
      "types": "./dist/types/browser-execution.d.ts",
      "import": "./dist/types/browser-execution.js"
    },
    "./types/vision-snapshot": {
      "types": "./dist/types/vision-snapshot.d.ts",
      "import": "./dist/types/vision-snapshot.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w",
    "type-check": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
