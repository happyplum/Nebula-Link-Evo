{
  "version": "2.0",
  "description": "Nebula-Link Evo AI 配置",
  "providers": {
    "kimi": {
      "name": "Kimi (Moonshot)",
      "enabled": false,
      "apiKey": "{KIMI_API_KEY}",
      "baseUrl": "https://api.moonshot.cn/v1",
      "mcp": [
        "browser-control",
        "file-access"
      ],
      "models": {
        "moonshot-v1-vision-k2.5": {
          "type": "decision",
          "capabilities": [
            "decision"
          ],
          "temperature": 0.2,
          "maxTokens": 1000
        }
      }
    },
    "glm": {
      "name": "智谱 GLM",
      "enabled": true,
      "apiKey": "{GLM_API_KEY}",
      "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
      "mcp": [
        "browser-control",
        "file-access"
      ],
      "models": {
        "glm-4.5v": {
          "type": "vision",
          "capabilities": [
            "vision"
          ],
          "temperature": 0.4,
          "maxTokens": 2000
        },
        "glm-4.1v-thinking-flashx": {
          "type": "vision",
          "capabilities": [
            "vision"
          ],
          "temperature": 0.4,
          "maxTokens": 2000
        },
        "glm-4.6v-flash": {
          "type": "vision",
          "capabilities": [
            "vision"
          ],
          "temperature": 0.4,
          "maxTokens": 2000
        },
        "glm-4.5-air": {
          "type": "decision",
          "capabilities": [
            "decision"
          ],
          "temperature": 0.3,
          "maxTokens": 1000
        },
        "glm-4.7-flash": {
          "type": "decision",
          "capabilities": [
            "decision"
          ],
          "temperature": 0.3,
          "maxTokens": 1000
        }
      }
    },
    "openai": {
      "name": "OpenAI",
      "enabled": false,
      "apiKey": "{OPENAI_API_KEY}",
      "baseUrl": "https://api.openai.com/v1",
      "mcp": [
        "browser-control",
        "file-access"
      ],
      "models": {
        "gpt-4o": {
          "type": "multimodal",
          "capabilities": [
            "vision",
            "decision"
          ],
          "temperature": 0.2,
          "maxTokens": 2000
        },
        "gpt-4o-mini": {
          "type": "vision",
          "capabilities": [
            "vision"
          ],
          "temperature": 0.3,
          "maxTokens": 1000
        }
      }
    },
    "anthropic": {
      "name": "Anthropic Claude",
      "enabled": false,
      "apiKey": "{ANTHROPIC_API_KEY}",
      "baseUrl": "https://api.anthropic.com/v1",
      "mcp": [
        "browser-control",
        "file-access"
      ],
      "models": {
        "claude-3-haiku-20250714": {
          "type": "vision",
          "capabilities": [
            "vision"
          ],
          "temperature": 0.3,
          "maxTokens": 1000
        }
      }
    },
    "nvidia": {
      "name": "NVIDIA",
      "enabled": true,
      "apiKey": "{NVIDIA_API_KEY}",
      "baseUrl": "https://integrate.api.nvidia.com/v1",
      "mcp": [
        "browser-control",
        "file-access"
      ],
      "models": {
        "moonshotai/kimi-k2.5": {
          "type": "multimodal",
          "capabilities": [
            "vision",
            "decision"
          ],
          "temperature": 0.2,
          "maxTokens": 2000
        },
        "minimaxai/minimax-m2.5": {
          "type": "decision",
          "capabilities": [
            "decision"
          ],
          "temperature": 0.7,
          "maxTokens": 16384
        },
        "z-ai/glm5": {
          "type": "decision",
          "capabilities": [
            "decision"
          ],
          "temperature": 1.0,
          "maxTokens": 16384
        }
      }
    },
    "vercel-ai": {
      "name": "Vercel AI SDK",
      "enabled": false,
      "apiKey": "{OPENAI_API_KEY}",
      "baseUrl": "https://api.openai.com/v1",
      "mcp": [
        "browser-control",
        "file-access"
      ],
      "models": {
        "gpt-4o": {
          "type": "multimodal",
          "capabilities": [
            "vision",
            "decision"
          ],
          "temperature": 0.2,
          "maxTokens": 2000
        }
      }
    }
  },
  "mcp": {
    "enabled": true,
    "servers": {
      "browser-control": {
        "enabled": true,
        "command": "npx",
        "args": [
          "-y",
          "@playwright/mcp@latest",
          "--cdp-endpoint",
          "http://localhost:9222"
        ],
        "env": {}
      }
    }
  },
  "defaults": {
    "mode": "separation",
    "vision": {
      "provider": "glm",
      "model": "glm-4.6v-flash"
    },
    "decision": {
      "provider": "glm",
      "model": "glm-4.7-flash"
    }
  },
  "settings": {
    "timeout": "{TIMEOUT:30000}",
    "maxRetries": "{MAX_RETRIES:3}",
    "temperature": 0.2,
    "maxTokens": 1000,
    "maxSteps": 3
  }
}