{
  "version": "2.0",
  "description": "Nebula-Link Evo AI 配置",
  "providers": {
    "kimi": {
      "baseUrl": "https://api.moonshot.cn/v1",
      "apiKey": "{KIMI_API_KEY}",
      "enabled": true,
      "models": {
        "moonshot-v1-vision-k2.5": {
          "type": "multimodal",
          "capabilities": ["decision", "vision"]
        }
      }
    },
    "glm": {
      "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
      "apiKey": "{GLM_API_KEY}",
      "enabled": true,
      "models": {
        "glm-4.5v": {
          "type": "vision",
          "capabilities": ["vision"]
        }
      }
    },
    "nvidia": {
      "baseUrl": "https://integrate.api.nvidia.com/v1",
      "apiKey": "{NVIDIA_API_KEY}",
      "enabled": false
    },
    "openai": {
      "npmPackage": "@ai-sdk/openai",
      "baseUrl": "https://api.openai.com/v1",
      "apiKey": "{OPENAI_API_KEY}",
      "enabled": false
    },
    "anthropic": {
      "npmPackage": "@ai-sdk/anthropic",
      "baseUrl": "https://api.anthropic.com/v1",
      "apiKey": "{ANTHROPIC_API_KEY}",
      "enabled": false
    }
  },
  "defaults": {
    "mode": "unified",
    "decision": "kimi/moonshot-v1-vision-k2.5",
    "vision": "glm/glm-4.5v"
  },
  "mcp": {
    "enabled": true,
    "servers": {}
  },
  "settings": {
    "timeout": "{TIMEOUT:30000}",
    "maxRetries": "{MAX_RETRIES:3}",
    "temperature": 0.2,
    "maxTokens": 1000,
    "maxSteps": 3
  }
}
