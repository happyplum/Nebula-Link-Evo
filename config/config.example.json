{
  "$schema": "https://opencode.ai/config.json",
  "version": "1.0",
  "description": "Nebula-Link Evo AI 配置",
  "providers": {
    "kimi": {
      "name": "Kimi (Moonshot)",
      "enabled": true,
      "apiKey": "{KIMI_API_KEY}",
      "baseUrl": "https://api.moonshot.cn/v1",
      "mcp": [
        "browser-control"
      ],
      "models": {
        "moonshot-v1-vision-k2.5": {
          "type": "decision",
          "capabilities": [
            "decision"
          ],
          "temperature": 0.2,
          "maxTokens": 1000
        }
      }
    },
    "glm": {
      "name": "智谱 GLM",
      "enabled": true,
      "apiKey": "{GLM_API_KEY}",
      "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
      "mcp": [
        "browser-control",
        "file-access"
      ],
      "models": {
        "glm-4.5v": {
          "type": "vision",
          "capabilities": [
            "vision"
          ],
          "temperature": 0.7,
          "maxTokens": 2000
        }
      }
    },
    "nvidia": {
      "name": "NVIDIA",
      "enabled": false,
      "apiKey": "{NVIDIA_API_KEY}",
      "baseUrl": "https://integrate.api.nvidia.com/v1",
      "mcp": [
        "browser-control"
      ],
      "models": {
        "nv-llama": {
          "type": "multimodal",
          "capabilities": [
            "vision",
            "decision"
          ],
          "temperature": 0.2,
          "maxTokens": 2000
        }
      }
    },
    "openai": {
      "name": "OpenAI",
      "enabled": false,
      "apiKey": "{OPENAI_API_KEY}",
      "baseUrl": "https://api.openai.com/v1",
      "mcp": [
        "browser-control"
      ],
      "models": {
        "gpt-4o": {
          "type": "multimodal",
          "capabilities": [
            "vision",
            "decision"
          ],
          "temperature": 0.2,
          "maxTokens": 2000
        },
        "gpt-4o-mini": {
          "type": "vision",
          "capabilities": [
            "vision"
          ],
          "temperature": 0.3,
          "maxTokens": 1000
        }
      }
    },
    "anthropic": {
      "name": "Anthropic Claude",
      "enabled": false,
      "apiKey": "{ANTHROPIC_API_KEY}",
      "baseUrl": "https://api.anthropic.com/v1",
      "mcp": [
        "browser-control"
      ],
      "models": {
        "claude-3-haiku-20250714": {
          "type": "vision",
          "capabilities": [
            "vision"
          ],
          "temperature": 0.3,
          "maxTokens": 1000
        }
      }
    }
  },
  "mcp": {
    "enabled": true,
    "servers": {
      "browser-control": {
        "enabled": false,
        "command": "npx",
        "args": [
          "-y",
          "@playwright/mcp@latest",
          "--cdp-endpoint",
          "ws://localhost:3001/cdp"
        ],
        "env": {}
      }
    }
  },
  "defaults": {
    "mode": "separation",
    "vision": {
      "provider": "glm",
      "model": "glm-4.5v"
    },
    "decision": {
      "provider": "kimi",
      "model": "moonshot-v1-vision-k2.5"
    }
  },
  "settings": {
    "timeout": "{TIMEOUT:30000}",
    "maxRetries": "{MAX_RETRIES:3}",
    "temperature": 0.2,
    "maxTokens": 1000
  }
}