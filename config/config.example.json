{
  "version": "2.0",
  "description": "Nebula-Link Evo AI 配置",
  "providers": {
    "kimi": {
      "baseUrl": "https://api.moonshot.cn/v1",
      "apiKey": "{KIMI_API_KEY}",
      "enabled": true
    },
    "glm": {
      "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
      "apiKey": "{GLM_API_KEY}",
      "enabled": true
    },
    "nvidia": {
      "baseUrl": "https://integrate.api.nvidia.com/v1",
      "apiKey": "{NVIDIA_API_KEY}",
      "enabled": false
    },
    "openai": {
      "npmPackage": "@ai-sdk/openai",
      "baseUrl": "https://api.openai.com/v1",
      "apiKey": "{OPENAI_API_KEY}",
      "enabled": false
    },
    "anthropic": {
      "npmPackage": "@ai-sdk/anthropic",
      "baseUrl": "https://api.anthropic.com/v1",
      "apiKey": "{ANTHROPIC_API_KEY}",
      "enabled": false
    }
  },
  "defaults": {
    "mode": "separation",
    "decision": "kimi/moonshot-v1-vision-k2.5",
    "vision": "glm/glm-4.5v"
  },
  "visionTool": {
    "maxCallsPerStep": 5,
    "timeoutMs": 30000,
    "screenshotQuality": 80
  },
  "mcp": {
    "enabled": true,
    "servers": {
      "browser-control": {
        "enabled": false,
        "command": "node",
        "args": ["../browser-control-mcp-server/dist/index.js"],
        "env": {
          "PLAYWRIGHT_SERVER_URL": "http://localhost:3001"
        }
      },
      "vision-server": {
        "enabled": true,
        "command": "node",
        "args": ["../vision-mcp-server/dist/index.js"],
        "env": {
          "PLAYWRIGHT_SERVER_URL": "http://localhost:3001",
          "VISION_PROVIDER_BASE_URL": "https://open.bigmodel.cn/api/paas/v4",
          "VISION_PROVIDER_API_KEY": "{GLM_API_KEY}",
          "VISION_MODEL_ID": "glm-4.5v"
        }
      }
    }
  },
  "settings": {
    "timeout": "{TIMEOUT:30000}",
    "maxRetries": "{MAX_RETRIES:3}",
    "temperature": 0.2,
    "maxTokens": 1000,
    "maxSteps": 3
  }
}