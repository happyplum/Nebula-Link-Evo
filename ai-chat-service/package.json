{
  "name": "ai-chat-service",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -b",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:e2e": "pnpm --filter proxy-adapter build && vitest run --config vitest.e2e.config.ts",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "verify:harness-bom": "tsx src/harness/verify-bom.ts",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\""
  },
