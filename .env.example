# AI 服务 API Keys
# 配置在 config/config.json 中，使用 {VAR_NAME} 语法引用环境变量

# Kimi (Moonshot)
KIMI_API_KEY=your_kimi_api_key_here

# 智谱 GLM
GLM_API_KEY=your_glm_api_key_here

# NVIDIA (可选)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Google Gemini (可选)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (可选)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (可选)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 服务端口
PLAYWRIGHT_PORT=3001
YOLO_PORT=3002
PROXY_PORT=3000

# YOLO 配置
YOLO_ENDPOINT=http://localhost:3002
YOLO_CONFIDENCE=0.5

# MCP Server 配置 (可选)
SERVER_URL=ws://localhost:8080
ROOT_PATH=/tmp

# LiveKit WebRTC 屏幕流
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_ROOM_NAME=nebula-link-screen

# 运行时覆盖 (可选)
# VISION_PROVIDER=glm
# VISION_MODEL=glm-4.5v
# DECISION_PROVIDER=kimi
# DECISION_MODEL=moonshot-v1-vision-k2.5
# VISION_MODE=separation
