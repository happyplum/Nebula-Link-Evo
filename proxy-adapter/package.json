{
  "name": "proxy-adapter",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "type-check": "tsc --noEmit",
    "build": "tsc -b",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && cross-env LOG_LEVEL=error vitest run --config vitest.e2e.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "catalog:",
    "@fastify/type-provider-typebox": "catalog:",
    "@livekit/rtc-node": "catalog:",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nebula-link-evo/shared": "workspace:*",
    "@sinclair/typebox": "catalog:",
    "async-mutex": "^0.5.0",
    "dotenv": "catalog:",
    "fastify": "catalog:",
    "fastify-plugin": "catalog:",
    "livekit-server-sdk": "catalog:",
    "pino": "^10.3.1",
    "playwright": "^1.62.1",
    "sharp": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "cross-env": "^10.1.0",
    "eventsource-parser": "^3.1.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
