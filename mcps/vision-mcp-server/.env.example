# Vision model provider (required — server won't start without these)
VISION_PROVIDER_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_PROVIDER_API_KEY=your-api-key-here
VISION_MODEL_ID=glm-4.5v

# Playwright server (optional)
PLAYWRIGHT_SERVER_URL=http://localhost:3001

# Vision model tuning (optional)
VISION_MAX_TOKENS=2048
VISION_TEMPERATURE=0.1
VISION_TIMEOUT_MS=30000
VISION_MAX_RETRIES=2
