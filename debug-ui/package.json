{
  "name": "debug-ui",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5173",
    "build": "vite build",
    "preview": "vite preview --host --port 4173",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "test:e2e": "pnpm --filter proxy-adapter build && pnpm --filter ai-chat-service build && node scripts/run-e2e.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "catalog:",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "catalog:",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^28.1.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@nebula-link-evo/agent-activity-ui": "workspace:*",
    "@nebula-link-evo/shared": "workspace:*",
    "@tanstack/react-query": "^5.96.0",
    "dayjs": "^1.11.20",
    "livekit-client": "catalog:",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.12"
  }
}
